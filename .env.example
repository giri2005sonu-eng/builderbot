# Copy to .env and add YOUR keys. Never commit .env.
TINYFISH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Max pages per part that may use Gemini as a backup when the page rules cannot read a price (0 = never)
GEMINI_FALLBACK_MAX=1
# Hybrid planning: Gemini is only used for ideas that are NOT in the 168-project catalog and NOT already learned.
# Max Gemini plans per visitor session (each plan is saved, so repeats cost nothing)
FORGE_GEMINI_PLANS_PER_SESSION=5
# Where learned plans are saved (default: core/project_data/learned_projects.json). Use a persistent path when deploying.
FORGE_LEARNED_PATH=
# Gemini price-reading backups per part for catalog/learned builds (0 = never; TinyFish + page rules only)
FORGE_DATASET_GEMINI_FALLBACK=0
# Hours a cached TinyFish/price result stays valid before it is fetched again (0 = never expires)
FORGE_CACHE_HOURS=72
# Project Optimizer: max number of new part profiles it may create per process for parts you type (0 = never)
OPT_FILL_MAX=40
# Where run-time optimizer data is saved (default: data/swap_store.json). Use a persistent path when deploying.
FORGE_SWAP_STORE=
